# Copy to .env.local (running with npm) or .env (running with Docker) and fill in. Never commit the filled-in file.

# --- Database (required) -------------------------------------------------------
# The web app connects as app_user, which is subject to row level security.
DATABASE_URL=
# The background worker connects as app_worker. Leave empty to reuse DATABASE_URL (not recommended).
WORKER_DATABASE_URL=
# Used only by `npm run migrate`: a role that can create tables and roles.
DATABASE_ADMIN_URL=
# Passwords that `npm run migrate` sets on the two app roles. Use long random values.
APP_USER_PASSWORD=
APP_WORKER_PASSWORD=
# Docker only: the database container's own settings.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Secrets (required) --------------------------------------------------------
# At least 32 random characters. Signs cookies. Changing it signs everyone out.
AUTH_SECRET=
# Encrypts saved Google and AI keys. Format: id:base64key, newest first, comma separated.
# Make one with: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# To rotate, add a new line with id 2 in front and keep the old line: new secrets use id 2, old ones stay readable.
# Losing every line makes saved Google and AI keys unreadable (people just reconnect them).
APP_ENCRYPTION_KEYS=

# --- Web address ---------------------------------------------------------------
# Public address people type, no trailing slash. Used in emails and the Google sign-in return address.
BASE_URL=
# Set to true when a proxy you run (Caddy, nginx) sits in front, so rate limits see real addresses.
TRUST_PROXY=
# Force the "secure" flag on cookies even if BASE_URL is plain http (leave empty otherwise).
COOKIE_SECURE=

# --- Photos --------------------------------------------------------------------
# Folder for uploaded pictures. Back it up with the database.
PHOTO_DIR=

# --- Google Calendar (optional; the sync section stays off without it) ---------
# Create your own OAuth client in Google Cloud Console (type: Web application).
# Authorised redirect URI: BASE_URL + /api/v1/sync/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "testing" until Google verifies your app, then "production". In testing, Google ends each sign-in after 7 days.
GOOGLE_OAUTH_STATUS=
# Only for tests against a stand-in server. Leave empty.
GOOGLE_AUTH_URL=
GOOGLE_TOKEN_URL=
GOOGLE_REVOKE_URL=
GOOGLE_API_BASE=

# --- Email (optional; without it, invitations show a link to copy and reminders are not sent) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Ads and demo --------------------------------------------------------------
# true switches the small photo-screensaver ads on for new households. Each household can still turn them off.
ADS_DEFAULT_ON=
# true shows "Try the sample household" on the welcome page.
ALLOW_DEMO=
SHOW_DESIGN_PAGE=            # true shows the internal /design parts gallery on a live site; leave empty

# --- AI (optional; people bring their own keys in Settings) ---------------------
# Requests per household per 24 hours.
AI_DAILY_CALL_CAP=
# false blocks AI servers on private addresses (turn this off when strangers can sign up).
ALLOW_PRIVATE_AI_URLS=

# --- Backups ---------------------------------------------------------------------
# Folder for nightly database dumps and how many days to keep.
BACKUP_DIR=
BACKUP_KEEP_DAYS=

# --- Public https (docker compose --profile https) ---------------------------------
# The address people will type, for example family.example.com. DNS must point at this computer.
DOMAIN=
